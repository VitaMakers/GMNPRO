# Chave da Google Places API (New), usada pela Auditoria do Perfil.
# Crie em https://console.cloud.google.com — ative "Places API (New)" e
# gere uma chave. A chave fica só no servidor, nunca é exposta ao navegador.
GOOGLE_PLACES_API_KEY=

# Supabase — contas, agendamento de postagens e hospedagem de imagens.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: SÓ no servidor (publicador agendado). Nunca no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (módulo de postagens, escopo business.manage).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# URL base do site (para o redirect do OAuth), ex.: https://gmnpro-ten.vercel.app
APP_BASE_URL=
# Segredo para proteger o endpoint do agendador (cron).
CRON_SECRET=
