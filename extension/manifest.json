{
  "manifest_version": 3,
  "name": "GMN PRO — Pré-análise",
  "version": "1.3.0",
  "description": "Pré-análise de perfis do Google (Meu Negócio) direto da página, sem custo. Envia os dados para o GMN PRO.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://www.google.com/*",
    "https://www.google.com.br/*",
    "https://maps.google.com/*",
    "https://app.vitamakers.com.br/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GMN PRO — Pré-análise"
  }
}
