{
  "manifest_version": 3,
  "name": "GMN PRO — Pré-análise",
  "version": "3.1.0",
  "description": "Pré-análise de perfis do Google (Meu Negócio) direto da ficha, sem custo. Abre o Maps, rola e envia os dados ao GMN PRO.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://www.google.com.br/*",
    "https://maps.google.com/*",
    "https://app.vitamakers.com.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/*",
        "https://www.google.com.br/*",
        "https://maps.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GMN PRO — Pré-análise",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
